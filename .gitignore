# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/web/coverage

# next.js (web workspace)
/apps/web/.next/
/apps/web/out/
/apps/web/test-results/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reports
reports/*.csv
reports/*.json

# graphify generated output (regenerable with `graphify update .`)
graphify-out/

# playwright runtime artifact (regenerated every run; never commit)
**/test-results/.last-run.json

# verification harness generated results
/scripts/verification/results/
