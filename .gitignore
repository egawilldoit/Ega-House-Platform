# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Tool caches inside workspace node_modules trees. The root rule above is
# anchored, so it does not reach them, and a vitest results.json was committed
# that way by accident. Scoped to the cache directories rather than to
# `**/node_modules/` on purpose: scripts/ega-runner/node_modules is deliberately
# vendored in this repository and must stay committable.
/**/node_modules/.vite/
/**/node_modules/.cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/web/coverage

# next.js (web workspace)
/apps/web/.next/
/apps/web/out/
/apps/web/test-results/

# production
/build
/apps/server/index.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/mobile/.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reports
reports/*.csv
reports/*.json
/.superpowers/

# graphify generated output (regenerable with `graphify update .`)
graphify-out/

# playwright runtime artifact (regenerated every run; never commit)
**/test-results/.last-run.json
