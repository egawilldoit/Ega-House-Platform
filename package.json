{
  "name": "ega-house",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:session": "tsx --test src/lib/supabase/cookie-options.test.ts",
    "test:timer-recovery": "tsx --test src/app/timer/session-recovery.test.ts",
    "test:auth-session:e2e": "playwright test tests/auth-session.e2e.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sonar:export-reliability": "node scripts/export-sonar-reliability-issues.mjs",
    "test:agent-context": "node --test scripts/agent/validate-agent-context.test.mjs",
    "validate:agent-context": "npm run test:agent-context && node scripts/agent/validate-agent-context.mjs",
    "preflight:hermes-skills": "node scripts/agent/preflight-hermes-skills.mjs",
    "typecheck:ega-runner": "tsc --noEmit -p scripts/ega-runner/tsconfig.json",
    "test:ega-runner-pr-loop": "node --import tsx --test scripts/ega-runner/test/pr-loop-contract.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.49.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "next": "^15.5.15",
    "postgres": "^3.4.9",
    "posthog-js": "^1.369.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.7"
  }
}
