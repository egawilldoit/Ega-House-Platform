# @ega/server runtime environment (local/dev `src/serve.ts` AND the Vercel
# deployment of `api/index.ts`). Copy to `.env` for local runs; on Vercel set
# these as project environment variables instead. Never commit real values.

# Required: Supabase project the server verifies tokens against.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Fallbacks accepted by src/env.ts when the preferred pair above is absent
# (matches what the web workspace already injects):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local listen port for src/serve.ts only. Ignored by the Vercel function.
PORT=3001

# Mobile clients point at this server's deployed origin via EXPO_PUBLIC_API_BASE_URL
# in apps/mobile/.env.example (dedicated origin, e.g. https://ega-api.egawilldoit.online).
