name: Architecture Stack Validation

on:
  push:
    branches:
      - "arch/**"
  pull_request:
    branches:
      - main
      - "arch/**"

permissions:
  contents: read

env:
  PINNED_PR1_MAIN_SHA: 7b997c4e726615da36614cdbbd0665b4e88eff6f

jobs:
  pinned-main-baseline:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout pinned main
        uses: actions/checkout@v5
        with:
          ref: ${{ env.PINNED_PR1_MAIN_SHA }}

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm

      - name: Install exact dependencies
        id: install
        run: npm ci --no-audit --no-fund

      - name: Restore Linux x64 optional native bindings without resolving workspace graph
        if: ${{ always() && steps.install.outcome == 'success' && runner.os == 'Linux' }}
        shell: bash
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const os = require('node:os');
          const path = require('node:path');
          const { spawnSync } = require('node:child_process');

          const lock = JSON.parse(fs.readFileSync('package-lock.json', 'utf8'));
          const wanted = new Map();
          for (const pkg of Object.values(lock.packages ?? {})) {
            for (const [name, version] of Object.entries(pkg?.optionalDependencies ?? {})) {
              if (!/linux-x64-(?:gnu|glibc)/.test(name)) continue;
              if (!/^\d+\.\d+\.\d+(?:[-+].+)?$/.test(version)) continue;
              wanted.set(name, version);
            }
          }

          const missing = [...wanted].filter(([name]) =>
            !fs.existsSync(path.join('node_modules', ...name.split('/'), 'package.json'))
          );
          if (!missing.length) {
            console.log('All Linux x64 optional native bindings are present');
            process.exit(0);
          }

          const tempRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'ega-native-optionals-'));
          fs.writeFileSync(path.join(tempRoot, 'package.json'), '{"private":true}\n');
          const specs = missing.map(([name, version]) => `${name}@${version}`);
          console.log(`Restoring isolated native bindings: ${specs.join(', ')}`);
          const result = spawnSync('npm', [
            'install', '--prefix', tempRoot, '--no-save', '--package-lock=false',
            '--no-audit', '--no-fund', ...specs,
          ], { stdio: 'inherit' });
          if (result.status !== 0) process.exit(result.status ?? 1);

          for (const [name] of missing) {
            const src = path.join(tempRoot, 'node_modules', ...name.split('/'));
            const dest = path.join('node_modules', ...name.split('/'));
            fs.mkdirSync(path.dirname(dest), { recursive: true });
            fs.cpSync(src, dest, { recursive: true });
            if (!fs.existsSync(path.join(dest, 'package.json'))) {
              throw new Error(`Failed to restore ${name}`);
            }
          }
          fs.rmSync(tempRoot, { recursive: true, force: true });
          console.log(`Restored ${missing.length} native binding package(s) without mutating the workspace dependency graph`);
          NODE

      - name: Prove React resolution stayed pinned
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm ls react react-dom

      - name: Validate agent context
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run validate:agent-context

      - name: Typecheck EGA Runner
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run typecheck:ega-runner

      - name: Test EGA Runner PR loop
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run test:ega-runner-pr-loop

      - name: Typecheck web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run typecheck

      - name: Full-repo lint baseline report
        if: ${{ always() && steps.install.outcome == 'success' }}
        continue-on-error: true
        run: npm run lint

      - name: Test web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm test

      - name: Build web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        env:
          DATABASE_URL: "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
          MCP_ENABLED: "false"
          MCP_WRITES_ENABLED: "false"
          NEXT_PUBLIC_SUPABASE_URL: "https://example.supabase.co"
          NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: "sb_publishable_ci_placeholder"
          NEXT_PUBLIC_SITE_URL: "https://example.com"
        run: npm run build

  migration-head:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout exact migration head
        uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0

      - name: Verify committed PR1 diff hygiene
        shell: bash
        run: |
          git diff --check "$PINNED_PR1_MAIN_SHA"...HEAD
          git diff --stat "$PINNED_PR1_MAIN_SHA"...HEAD
          test -z "$(git status --porcelain)"

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm

      - name: Install exact dependencies
        id: install
        run: npm ci --no-audit --no-fund

      - name: Restore Linux x64 optional native bindings without resolving workspace graph
        if: ${{ always() && steps.install.outcome == 'success' && runner.os == 'Linux' }}
        shell: bash
        run: |
          node <<'NODE'
          const fs = require('node:fs');
          const os = require('node:os');
          const path = require('node:path');
          const { spawnSync } = require('node:child_process');

          const lock = JSON.parse(fs.readFileSync('package-lock.json', 'utf8'));
          const wanted = new Map();
          for (const pkg of Object.values(lock.packages ?? {})) {
            for (const [name, version] of Object.entries(pkg?.optionalDependencies ?? {})) {
              if (!/linux-x64-(?:gnu|glibc)/.test(name)) continue;
              if (!/^\d+\.\d+\.\d+(?:[-+].+)?$/.test(version)) continue;
              wanted.set(name, version);
            }
          }

          const missing = [...wanted].filter(([name]) =>
            !fs.existsSync(path.join('node_modules', ...name.split('/'), 'package.json'))
          );
          if (!missing.length) {
            console.log('All Linux x64 optional native bindings are present');
            process.exit(0);
          }

          const tempRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'ega-native-optionals-'));
          fs.writeFileSync(path.join(tempRoot, 'package.json'), '{"private":true}\n');
          const specs = missing.map(([name, version]) => `${name}@${version}`);
          console.log(`Restoring isolated native bindings: ${specs.join(', ')}`);
          const result = spawnSync('npm', [
            'install', '--prefix', tempRoot, '--no-save', '--package-lock=false',
            '--no-audit', '--no-fund', ...specs,
          ], { stdio: 'inherit' });
          if (result.status !== 0) process.exit(result.status ?? 1);

          for (const [name] of missing) {
            const src = path.join(tempRoot, 'node_modules', ...name.split('/'));
            const dest = path.join('node_modules', ...name.split('/'));
            fs.mkdirSync(path.dirname(dest), { recursive: true });
            fs.cpSync(src, dest, { recursive: true });
            if (!fs.existsSync(path.join(dest, 'package.json'))) {
              throw new Error(`Failed to restore ${name}`);
            }
          }
          fs.rmSync(tempRoot, { recursive: true, force: true });
          console.log(`Restored ${missing.length} native binding package(s) without mutating the workspace dependency graph`);
          NODE

      - name: Prove React resolution stayed pinned
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm ls react react-dom

      - name: Validate agent context
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run validate:agent-context

      - name: Typecheck EGA Runner
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run typecheck:ega-runner

      - name: Test EGA Runner PR loop
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run test:ega-runner-pr-loop

      - name: Typecheck web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm run typecheck

      - name: Full-repo lint informational report
        if: ${{ always() && steps.install.outcome == 'success' }}
        continue-on-error: true
        run: npm run lint

      - name: Test web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        run: npm test

      - name: Build web root
        if: ${{ always() && steps.install.outcome == 'success' }}
        env:
          DATABASE_URL: "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
          MCP_ENABLED: "false"
          MCP_WRITES_ENABLED: "false"
          NEXT_PUBLIC_SUPABASE_URL: "https://example.supabase.co"
          NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: "sb_publishable_ci_placeholder"
          NEXT_PUBLIC_SITE_URL: "https://example.com"
        run: npm run build

      - name: Test architecture guardrails when available
        if: ${{ always() && steps.install.outcome == 'success' }}
        shell: bash
        run: |
          if node -e "const p=require('./package.json');process.exit(p.scripts?.['test:architecture'] ? 0 : 1)"; then
            npm run test:architecture
          else
            echo "test:architecture not present on this commit"
          fi

      - name: Check architecture guardrails when available
        if: ${{ always() && steps.install.outcome == 'success' }}
        shell: bash
        run: |
          if node -e "const p=require('./package.json');process.exit(p.scripts?.['check:architecture'] ? 0 : 1)"; then
            npm run check:architecture
          else
            echo "check:architecture not present on this commit"
          fi

      - name: Report validation workspace mutations
        if: ${{ always() }}
        run: git status --short
